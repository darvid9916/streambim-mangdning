    "byClass": {
      "Arkitekt": [
        "Wall",
        "CurtainWall",
        "Door",
        "Window",
        "Covering",
        "Railing",
        "Ramp",
        "Roof",
        "Stair",
        "StairFlight",
        "Furniture",
        "FurnishingElement",
        "SystemFurnitureElement",
        "Space"
      ],
      "Konstruktion": [
        "Slab",
        "Beam",
        "Column",
        "Member",
        "Plate",
        "Footing",
        "Pile",
        "ElementAssembly",
        "MechanicalFastener",
        "DiscreteAccessory"
      ],
      "Ventilation": [
        "AirTerminal",
        "DuctFitting",
        "DuctSegment"
      ],
      "VS": [
        "PipeSegment",
        "PipeFitting"
      ],
      "Sprinkler": [
        "FireSuppressionTerminal"
      ],
      "El": [
        "CableCarrierFitting",
        "CableCarrierSegment",
        "LightFixture",
        "ElectricAppliance",
        "Alarm",
        "Outlet",
        "JunctionBox"
      ],
      "Hiss": [
        "TransportElement"
      ]
    },
    "other": "Övrigt"
  },
  "search": {
    "kindKey": "@kind",
    "autoLoad": 3000,
    "sampleSize": 200,
    "batch": 40,
    "maxLoad": 30000
  },
  "quantities": {
    "psetPattern": "^(BaseQuantities|Qto_.*)$",
    "default": {
      "length": [
        "Length",
        "NetLength",
        "GrossLength"
      ],
      "area": [
        "NetSideArea",
        "NetArea",
        "NetFootprintArea",
        "GrossSideArea",
        "GrossArea",
        "GrossFootprintArea",
        "Area"
      ],
      "volume": [
        "NetVolume",
        "GrossVolume",
        "Volume"
      ]
    },
    "byClass": {
      "Slab": {
        "area": [
          "NetArea",
          "GrossArea"
        ]
      },
      "Door": {
        "area": [
          "Area"
        ]
      },
      "Window": {
        "area": [
          "Area"
        ]
      },
      "Space": {
        "area": [
          "NetFloorArea",
          "GrossFloorArea"
        ]
      }
    },
    "scale": {
      "length": 1,
      "area": 1,
      "volume": 1
    }
  },
  "hiddenPropertyPrefixes": [
    "@kind",
    "BaseQuantities~",
    "Qto_",
    "GUID",
    "GlobalId",
    "System Global Id"
  ],
  "highlightColor": "2f8fdd"
}
